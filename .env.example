# Copy this file to .env and adjust values for your environment.
SEMANTIC_ARENA_SOLR_URL=http://localhost:8983/solr
SEMANTIC_ARENA_MEILISEARCH_URL=http://localhost:7700
SEMANTIC_ARENA_MEILISEARCH_MASTER_KEY=change-this-development-key

# An OpenAI-compatible embedding endpoint is required for indexing and search.
# Examples: http://localhost:11434/v1 (Ollama), http://localhost:1234/v1 (LM Studio)
SEMANTIC_ARENA_EMBEDDING_BASE_URL=http://localhost:11434/v1
SEMANTIC_ARENA_EMBEDDING_MODEL=nomic-embed-text
SEMANTIC_ARENA_EMBEDDING_DIMENSIONS=768
SEMANTIC_ARENA_EMBEDDING_API_KEY=

# Optional. Leave blank to use deterministic extractive selection without an LLM.
SEMANTIC_ARENA_SELECTOR_BASE_URL=
SEMANTIC_ARENA_SELECTOR_MODEL=
SEMANTIC_ARENA_SELECTOR_API_KEY=
